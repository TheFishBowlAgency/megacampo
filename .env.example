MULTIBANCO_SANDBOX=true
IFTHENPAY_ANTI_PHISHING_KEY=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Protects /api/checkout/expire (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
